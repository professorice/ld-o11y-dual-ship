# Copy to .env and fill in your values:
#   cp .env.example .env

# LaunchDarkly
LAUNCHDARKLY_SDK_KEY=sdk-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
LAUNCHDARKLY_CLIENT_SIDE_ID=your-client-side-id

# Datadog Agent (docker-compose) — dual-ship to Datadog + LaunchDarkly
# DD_API_KEY can be a placeholder if you only ship to LaunchDarkly; use a real key for Datadog too.
DD_API_KEY=your-datadog-api-key
DD_SITE=datadoghq.com

# App tracers send spans to the Agent (not directly to LaunchDarkly)
DD_AGENT_HOST=localhost
DD_TRACE_OTEL_ENABLED=true

# run.sh builds DD_APM_ADDITIONAL_ENDPOINTS for the Agent from LAUNCHDARKLY_CLIENT_SIDE_ID.
# docker-compose.yml sets DD_TAGS=launchdarkly.project_id:<client-side-id> on the Agent (host tag for LD routing).

# Per-app service names
DD_SERVICE_JAVA=ld-o11y-demo-java
DD_SERVICE_GO=ld-o11y-demo-go

# Optional: override Datadog Java tracer path (default: java/lib/dd-java-agent.jar, auto-downloaded)
# DD_JAVA_AGENT=java/lib/dd-java-agent.jar
